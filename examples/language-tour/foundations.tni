// Strategic declarations and reusable shared-kernel members.
subdomain Commerce kind core
subdomain Fulfillment kind supporting
subdomain SharedCapabilities kind generic
subdomain Unclassified

bounded context Ordering realizes Commerce, SharedCapabilities
bounded context Shipping realizes Fulfillment
bounded context Billing realizes Commerce
bounded context Support

in bounded context Shipping {
  aggregate Shipment {
    root entity Shipment {
      identifier id: ShipmentId
    }

    value object ShipmentId {
      raw: string
    }
  }
}

shared kernel CommonTypes {
  value object CorrelationId {
    raw: string
  }

  enum Role {
    Customer,
    Operator,
    System
  }

  domain service AccessPolicy {
    method permits(role: Role, action: string) returns boolean
  }
  domain service UnspecifiedPolicy

  module SharedContracts {
    exposes SharedToken, TenantId

    value object SharedToken {
      raw: string
    }

    value object TenantId {
      raw: string
    }

    module Identifiers {
      exposes ExternalId

      value object ExternalId {
        raw: string
      }
    }
  }
}

actor Customer
actor Operator
