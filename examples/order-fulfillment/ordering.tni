import "./context-catalog.tni";
import "./common-types.tni" as Common;
import "./context-map.tni" { FulfillmentMap };

part of bounded context Ordering {

    capability OrderFulfillment;

    aggregate Order {
        root entity OrderRoot operations {
            constructor(id: OrderId, owner: string) {
                invariant "An order must have an identifier and an owner.";
                precondition "The supplied identifier is non-empty.";
                behavior $"Normalize the identifier with ${OrderId.normalize} before creating the order.";
                postcondition "The order has an identifier and owner.";
            }
            method ensureOwner();
            method place() emits OrderPlaced {
                transition status from Draft to Placed;
            }
        } {
            identifier id: OrderId;
            owner: string;
            currency: Common.Currency;
            orderId: OrderId;
            status: OrderStatus;
            lines: List<OrderLine>;
            labels: Set<string>;
            quantities: Map<string, number>;
            externalReference?: string;
            invariant $"An order must have an owner; check ${OrderRoot.ensureOwner}.";
        }

        identifier value object OrderId for OrderRoot operations {
            constructor(raw: string) {
                precondition "The raw identifier is non-empty.";
                behavior $"Normalize the value with ${OrderId.normalize}.";
                postcondition "The identifier value is normalized.";
            }
            method normalize() returns string;
        } {
            raw: string;
            invariant "An order identifier is non-empty.";
        }

        value object OrderLine {
            sku: string;
            quantity: number;
        }

        enum OrderStatus {
            Draft, Placed, Paid
        }

        domain service OrderPricing {
            method calculateTotal(amount: number, adjustments?: List<number>) returns number {
                precondition "The amount is non-negative.";
                behavior $"Validate the order with ${OrderRoot.ensureOwner}, then calculate its total.";
                postcondition "The returned total includes all adjustments.";
            }
        }

        invariant "Every order line has a positive quantity.";
        method addLine(line: OrderLine) {
            behavior "Add the line quantity to the order's lines.";
        }

        repository OrderRepository for Order;
        factory OrderFactory for Order;
    }

    event OrderPlaced data {
        orderId: OrderId;
    }
}
