import "./ordering.tni";

part of bounded context Ordering {
    command PlaceOrder
        handled by Customer
        targets Order
        with items: string
        emits OrderPlaced {
            precondition "The order contains at least one item.";
            behavior $"Check ${Order.OrderRoot.ensureOwner}, then calculate the total with ${Order.OrderPricing.calculateTotal}.";
            postcondition "OrderPlaced is emitted for the order.";
        }

    event OrderPlaced caused by PlaceOrder for Order publishes integration OrderPlacedV1 data {
        orderId: OrderId;
    }
    integration event OrderPlacedV1 from OrderPlaced data {
        orderId: OrderId;
    }
    policy ReserveInventory when OrderPlaced then PlaceOrder;
    read model OrderSummary from OrderPlaced;
    hotspot PaymentContract note "Payment API contract is unclear";
}
