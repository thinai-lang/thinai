import "./context-catalog.tni";
import "./ordering.tni";

part of bounded context Ordering {
    application service OrderApplication for Order {
        method placeOrder(items: List<OrderLine>) invokes Order.OrderRoot.place {
            precondition "The order contains at least one item.";
            behavior "First, authorize the Common.Role.Customer role for placing an order with [[Authorization.authorize]]; stop if authorization fails. Then place the order by invoking the aggregate root's place operation.";
            postcondition "The order is placed.";
        }

        method publishOrderPlaced(source: event OrderPlaced) emits OrderPlacedV1 {
            behavior "First, authorize the Common.Role.System role for publishing the event with [[Authorization.authorize]]; stop if authorization fails. Then map the internal event to the public integration contract.";
        }
    }

    integration event OrderPlacedV1 data {
        orderId: OrderId;
    }
    flow PlaceOrder {
        actor Customer;
        invoke OrderApplication.placeOrder;
    }
}
