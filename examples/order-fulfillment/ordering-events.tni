import "./context-catalog.tni";
import "./ordering.tni";

part of bounded context Ordering {
    application service OrderApplication for Order {
        transactional method placeOrder(input: PlaceOrderInput) returns PlaceOrderResult
            loads Order.OrderRepository by input.orderId
            invokes Order.Order.place
            saves Order.OrderRepository {
            precondition "The order contains at least one item.";
            behavior "First, authorize the Common.Role.Customer role for placing an order with [[Authorization.authorize]]; stop if authorization fails. Then place the order identified by [[input.orderId]] and return its [[result.status]].";
            postcondition "The order is placed.";
        }

        method publishOrderPlaced(source: event OrderPlaced)
            emits Contracts.OrderPlacedV1 after commit {
            behavior "First, authorize the Common.Role.System role for publishing the event with [[Authorization.authorize]]; stop if authorization fails. Then map the internal event to the public integration contract.";
        }
    }

    application service OrderItemFulfillment for Order {
        transactional method fulfillItem(orderId: OrderId, itemId: OrderItemId)
            loads Order.OrderRepository by orderId
            invokes Order.Order.fulfillItem
            saves Order.OrderRepository {
            behavior "Ship the selected child item through the aggregate root.";
        }
    }

    application service OrderMaintenance for Order {
        transactional method deleteDraftOrder(orderId: OrderId)
            loads Order.OrderRepository by orderId
            invokes Order.Order.validateCanDelete
            deletes Order.OrderRepository {
            behavior "Remove the order only after its root validates the deletion rule.";
        }
    }

    data object PlaceOrderInput {
        orderId: OrderId;
        items: List<OrderLine>;
    }
    data object PlaceOrderResult {
        orderId: OrderId;
        status: OrderStatus;
    }
    data object OrderEligibilityResult {
        eligible: boolean;
    }

    read model OrderSummary {
        orderId: OrderId;
        customerId: CustomerId;
        status: OrderStatus;
    }
    query repository OrderSummaryRepository for OrderSummary;

    read model CustomerSummary {
        customerId: CustomerId;
        name: string;
    }
    query repository CustomerSummaryRepository for CustomerSummary;

    projector OrderSummaryProjector for OrderSummary {
        method onOrderPlaced(source: event OrderPlaced)
            updates OrderSummaryRepository after commit {
            behavior "Project [[OrderPlaced.orderId]], [[OrderPlaced.customerId]], and [[OrderPlaced.status]] into [[OrderSummary.orderId]], [[OrderSummary.customerId]], and [[OrderSummary.status]].";
        }
    }

    projector CustomerSummaryProjector for CustomerSummary {
        method onCustomerRegistered(source: event CustomerRegistered)
            updates CustomerSummaryRepository after commit {
            behavior "Project [[CustomerRegistered.customerId]] and [[CustomerRegistered.name]] into [[CustomerSummary.customerId]] and [[CustomerSummary.name]].";
        }
    }

    query service OrderQueries {
        method canPlaceOrder(orderId: OrderId) returns OrderEligibilityResult {
            behavior "Read [[OrderSummaryRepository]] for [[orderId]] and return whether [[result.eligible]] is true.";
        }
        method findCustomerOrders(customerId: CustomerId)
            returns List<OrderSummary> {
            behavior "Combine [[OrderSummaryRepository]] and [[CustomerSummaryRepository]] for the selected customer.";
        }
    }

    module Contracts {
        exposes OrderPlacedV1;
        integration event OrderPlacedV1 data {
            orderId: string;
            customerId: string;
            status: string;
        }
    }

    flow PlaceOrder {
        actor Customer;
        invoke OrderQueries.canPlaceOrder
            with "orderId from [[OrderSummary.orderId]]"
            when "The customer requests an eligibility check for the selected order.";
        invoke OrderApplication.placeOrder
            with "input.orderId from [[OrderSummary.orderId]] and input.items from the selected order lines"
            when "The eligibility result [[Ordering.OrderQueries.canPlaceOrder.result.eligible]] is true.";
    }

    flow RegisterCustomerAndPlaceOrder {
        actor Customer;
        invoke CustomerRegistration.registerCustomer
            with "id from the customer identifier and name from the registration form";
        invoke OrderApplication.placeOrder
            with "orderId from the selected order and items from the requested order lines";
    }
}
