import "./context-catalog.tni";
import "./ordering.tni";

part of bounded context Shipping {
    identifier value object OrderId mirrors Ordering.Order.OrderId {
        raw: string;
    }

    aggregate Shipment {
        root entity ShipmentRoot {
            identifier id: ShipmentId;
            orderId: OrderId;
        }
        identifier value object ShipmentId for ShipmentRoot {
            raw: string;
        }
    }

    command CreateShipment targets Shipment emits ShipmentStarted;
    event ShipmentStarted for Shipment;

    module Operations {
        exposes TrackingCode;

        value object TrackingCode {
            raw: string;
        }
    }

    module Fulfillment depends on Operations {
        value object ShipmentMetadata {
            trackingCode: TrackingCode;
        }
    }
}
