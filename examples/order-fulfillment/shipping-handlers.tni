import "./context-catalog.tni";
import "./ordering.tni";
import "./ordering-events.tni";
import "./shipping.tni";
import "./context-map.tni" { FulfillmentMap };

part of bounded context Shipping {
    event storming OrderLifecycle {
        actor Customer;
        event Ordering.OrderPlacedV1;
        aggregate Shipment;
        method ShipmentApplication.createShipment;
        external system PaymentProvider;
        hotspot PaymentContract;
    }
}
