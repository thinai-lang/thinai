{
    "name": "thinai-workspace",
    "description": "Thinai DDD modeling language workspace",
    "version": "0.1.7-alpha.7",
    "license": "MIT",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=10.2.3"
    },
    "scripts": {
        "clean": "npm run clean --workspaces",
        "generate": "npm run --workspace packages/language langium:generate",
        "prebuild": "npm run generate",
        "watch": "tsc -b tsconfig.build.json --watch",
        "prewatch": "npm run generate",
        "build": "tsc -b tsconfig.build.json && npm run build --workspaces",
        "build:clean": "npm run clean && npm run build",
        "langium:generate": "npm run --workspace packages/language langium:generate",
        "langium:watch": "npm run --workspace packages/language langium:watch",
        "pretest": "npm run generate && tsc -b tsconfig.build.json",
        "test": "npm run --workspace packages/language test && vitest run --config packages/cli/vitest.config.ts",
        "coverage": "npm run --workspace packages/language coverage"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "openai": "^7.23.0",
        "shx": "~0.4.0",
        "typescript": "~5.9.3"
    },
    "workspaces": [
        "packages/language",
        "packages/cli",
        "packages/extension"
    ],
    "allowScripts": {
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true
    },
    "dependencies": {
        "langium-ai-tools": "^6.0.1"
    }
}
