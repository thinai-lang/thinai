{
    "name": "vscode-thinai",
    "publisher": "thinai-lang",
    "description": "Alpha: Thinai language support for VS Code",
    "keywords": [
        "ddd",
        "domain-driven-design",
        "modeling-language",
        "thinai",
        "vscode",
        "vscode-extension",
        "language-server"
    ],
    "version": "0.1.9-alpha.1",
    "license": "MIT",
    "displayName": "Thinai",
    "icon": "./icon.png",
    "type": "module",
    "engines": {
        "vscode": "^1.91.0"
    },
    "activationEvents": [
        "onLanguage:thinai"
    ],
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "configurationDefaults": {
            "[thinai]": {
                "editor.autoClosingBrackets": "languageDefined",
                "editor.autoClosingOvertype": "auto",
                "editor.detectIndentation": false,
                "editor.insertSpaces": true,
                "editor.quickSuggestions": {
                    "other": "on",
                    "comments": "off",
                    "strings": "on"
                },
                "editor.tabSize": 2,
                "editor.wordBasedSuggestions": "off",
                "files.insertFinalNewline": true,
                "files.trimTrailingWhitespace": false
            }
        },
        "languages": [
            {
                "id": "thinai",
                "aliases": [
                    "Thinai",
                    "thinai"
                ],
                "extensions": [
                    ".tni"
                ],
                "icon": {
                    "light": "./icons/thinai-light.svg",
                    "dark": "./icons/thinai-dark.svg"
                },
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "thinai",
                "scopeName": "source.thinai",
                "path": "syntaxes/thinai.tmLanguage.json"
            }
        ]
    },
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes",
        "vscode:prepublish": "npm run build",
        "build:prepare": "npm --prefix ../language run langium:generate && shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/thinai.tmLanguage.json ./syntaxes/thinai.tmLanguage.json",
        "build": "npm run build:prepare && tsc -b tsconfig.json && node esbuild.mjs",
        "build:clean": "npm run clean && npm run build",
        "watch": "npm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\""
    },
    "dependencies": {
        "langium": "~4.4.0",
        "thinai-language": "0.1.9-alpha.1",
        "vscode-languageclient": "~10.1.0",
        "vscode-languageserver": "~10.1.0"
    },
    "devDependencies": {
        "@types/vscode": "~1.91.0",
        "concurrently": "~10.0.4",
        "esbuild": "0.28.2"
    },
    "vsce": {
        "dependencies": false
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinai-lang/thinai.git",
        "directory": "packages/extension"
    },
    "homepage": "https://thinai-lang.dev/",
    "bugs": {
        "url": "https://github.com/thinai-lang/issues"
    }
}
