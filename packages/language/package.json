{
    "name": "thinai-language",
    "description": "Thinai language services, grammar, and validators",
    "version": "0.1.0-alpha.1",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "out",
        "src"
    ],
    "main": "./out/index.js",
    "module": "./out/index.js",
    "exports": {
        ".": {
            "types": "./out/index.d.ts",
            "default": "./out/index.js"
        }
    },
    "typesVersions": {
        "*": {
            ".": [
                "out/index"
            ]
        }
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "echo 'No build step'",
        "build:clean": "npm run clean && npm run build",
        "langium:generate": "langium generate && node scripts/patch-textmate.mjs",
        "langium:watch": "npm run langium:generate && node scripts/watch-langium.mjs",
        "test": "npm run langium:generate && vitest run",
        "coverage": "npm run langium:generate && vitest run --coverage"
    },
    "dependencies": {
        "chevrotain": "~13.2.0",
        "langium": "~4.4.0"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "~4.1.10",
        "langium-cli": "~4.4.0",
        "vitest": "~4.1.10",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thinai-lang/thinai.git",
        "directory": "packages/language"
    },
    "homepage": "https://thinai-lang.github.io/",
    "bugs": {
        "url": "https://github.com/thinai-lang/thinai/issues"
    }
}
