{
    "name": "thinai-cli",
    "description": "Alpha: Command-line tools for Thinai models",
    "version": "0.1.8-alpha.8",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=10.2.3"
    },
    "files": [
